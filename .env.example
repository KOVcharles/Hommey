# ================================================================
#  Hommey 智能旅行助手 - 环境变量配置
#  复制此文件为 .env 并填入实际值：
#    cp .env.example .env
# ================================================================

# ── 基础 API 配置（优先填写）────────────────────────────────────
# 主 LLM API（必填）
HOMMEY_API_KEY=your-key                                 # API 密钥
HOMMEY_MODEL_NAME=deepseek-v4-flash                     # 模型名称
HOMMEY_BASE_URL=https://llm-nmdvomnybf87lb5m.cn-beijing.maas.aliyuncs.com/compatible-mode/v1  # API 地址

# RAG Embedding API（默认 siliconflow 后端时必填）
# SiliconFlow API Key；也可用 SILICONFLOW_API_KEY。
HOMMEY_EMBEDDING_API_KEY=
HOMMEY_EMBEDDING_MODEL=BAAI/bge-m3                      # Embedding 模型
HOMMEY_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1 # Embedding API 地址

# ── LLM 生成参数 ────────────────────────────────────────────────
HOMMEY_TEMPERATURE=0.7                          # 生成随机性 (0-1)
HOMMEY_MAX_TOKENS=8192                          # 最大输出 token 数
# DeepSeek V4（百炼）默认会思考；false 通过 enable_thinking=false 关闭该模式。
HOMMEY_ENABLE_THINKING=false

# ── 多意图任务与答案 Composer ──────────────────────────────────
HOMMEY_COMPOSER_ENABLED=True                    # 启用专用答案 Composer
# 留空时复用主模型连接；可按成本与效果独立配置。
HOMMEY_COMPOSER_MODEL_NAME=
HOMMEY_COMPOSER_API_KEY=
HOMMEY_COMPOSER_BASE_URL=
HOMMEY_COMPOSER_TEMPERATURE=0.2
HOMMEY_COMPOSER_MAX_TOKENS=4096
# 留空时继承 HOMMEY_ENABLE_THINKING。
HOMMEY_COMPOSER_ENABLE_THINKING=
HOMMEY_TRIP_INTAKE_CARD=True                     # 启用结构化行程信息收集卡片

# 高德 Web 服务 API。Key 只在服务端使用；地点、酒店、天气和明确 POI 间路线仅覆盖中国大陆。
HOMMEY_AMAP_ENABLED=True
HOMMEY_AMAP_WEB_KEY=
HOMMEY_AMAP_BASE_URL=https://restapi.amap.com
HOMMEY_AMAP_TIMEOUT_SEC=8
HOMMEY_AMAP_MAX_RETRIES=1
HOMMEY_AMAP_CACHE_TTL_SEC=300
HOMMEY_AMAP_HOTEL_RADIUS_M=5000

# ── Turn 级 Shadow Evaluation（默认关闭）──────────────────────
HOMMEY_EVALUATION_ENABLED=false                  # 只开启异步快照采集与规则任务
HOMMEY_EVALUATION_LLM_ENABLED=false              # 单独开启 Judge LLM
HOMMEY_EVALUATION_SAMPLE_RATE=0.2
HOMMEY_EVALUATION_QUEUE_SIZE=256
HOMMEY_EVALUATION_WORKER_CONCURRENCY=2
HOMMEY_EVALUATION_JUDGE_TIMEOUT_SEC=30
# Judge 独立模型；开启 LLM 时必填。
HOMMEY_EVALUATION_JUDGE_MODEL=
# 留空时复用主连接凭证。
HOMMEY_EVALUATION_API_KEY=
# 留空时复用主模型地址。
HOMMEY_EVALUATION_BASE_URL=
HOMMEY_EVALUATION_CONTEXT_MESSAGES=4
HOMMEY_EVALUATION_RETENTION_DAYS=30
HOMMEY_EVALUATION_DB_POOL_SIZE=2
HOMMEY_EVALUATION_DB_TIMEOUT_SEC=5
HOMMEY_EVALUATION_LEASE_SECONDS=90
HOMMEY_EVALUATION_MAX_ATTEMPTS=3
HOMMEY_EVALUATOR_VERSION=turn-evaluator-v1
HOMMEY_JUDGE_PROMPT_VERSION=turn-judge-v1
HOMMEY_EVALUATION_RUBRIC_VERSION=travel-rubric-v1

# ── 系统配置 ────────────────────────────────────────────────────
HOMMEY_ENABLE_LLM=True                          # 是否启用 LLM
HOMMEY_LOG_LEVEL=INFO                           # 日志级别 (DEBUG/INFO/WARNING/ERROR)
HOMMEY_SYSTEM_MAX_RETRIES=3                     # 系统最大重试次数
HOMMEY_TIMEOUT=60                               # 请求超时（秒）

# ── RAG 知识库配置 ──────────────────────────────────────────────
HOMMEY_RAG_VECTOR_BACKEND=postgres                    # 生产使用 PostgreSQL + pgvector；测试可使用 memory
HOMMEY_RAG_REFRESH_BACKEND=postgres                   # 刷新任务和状态持久化到 PostgreSQL
HOMMEY_RAG_SOURCE_STORAGE=shared_filesystem           # 单主机多 worker 共享卷；多主机副本需 object_storage
HOMMEY_RAG_REFRESH_LEASE_SECONDS=90
HOMMEY_RAG_REFRESH_MAX_ATTEMPTS=3
HOMMEY_RAG_REFRESH_RETRY_DELAY_SECONDS=5
HOMMEY_RAG_REFRESH_POLL_SECONDS=2
HOMMEY_RAG_REFRESH_WORKER_STALE_SECONDS=45
# 留空时复用 HOMMEY_POSTGRES_DSN。
HOMMEY_RAG_POSTGRES_DSN=
HOMMEY_RAG_EMBEDDING_BACKEND=siliconflow             # siliconflow | local
HOMMEY_EMBEDDING_DIMENSION=1024                      # BAAI/bge-m3 输出维度
HOMMEY_EMBEDDING_BATCH_SIZE=32
HOMMEY_EMBEDDING_TIMEOUT_SEC=30
HOMMEY_RAG_EMBEDDING_MAX_RETRIES=2                     # Phase-5 嵌入请求最大重试次数（瞬时失败退避重试）
HOMMEY_RAG_EMBEDDING_RETRY_BASE_DELAY_SEC=1.0          # Phase-5 重试基础退避（指数增长）
HOMMEY_RAG_EMBEDDING_RETRY_MAX_DELAY_SEC=30.0          # Phase-5 重试最大退避上限
HOMMEY_RAG_EMBEDDING_CACHE_SIZE=1024                   # Phase-5 进程内嵌入 LRU 缓存条目数
HOMMEY_RAG_BM25_BACKEND=python                         # Phase-5 BM25/稀疏检索后端接缝（当前仅 python）
HOMMEY_RAG_DOCUMENTS_DIR=data/documents               # 文档目录
HOMMEY_RAG_KNOWLEDGE_BASE_PATH=data/rag_knowledge      # 本地清单、检索轨迹等运行文件目录
HOMMEY_RAG_COLLECTION=business_travel_knowledge         # PostgreSQL RAG 逻辑集合名
HOMMEY_RAG_CHUNK_SIZE=600                               # 旧字符切块器分块大小（兼容）
HOMMEY_RAG_CHUNK_OVERLAP=100                            # 旧字符切块器重叠长度（兼容）
HOMMEY_RAG_CHUNK_MIN_TOKENS=150                         # Phase-1 结构化切块：块最小 token
HOMMEY_RAG_CHUNK_MAX_TOKENS=400                         # Phase-1 结构化切块：块最大 token
HOMMEY_RAG_CHUNK_OVERLAP_TOKENS=60                      # Phase-1 结构化切块：跨块重叠 token
HOMMEY_RAG_TOP_K=3                                      # 检索返回 Top-K
HOMMEY_RAG_SUPPORTED_FILE_TYPES=txt,md,pdf,docx,csv,xlsx  # Phase-2 接受上传的文档类型（逗号分隔）
HOMMEY_RAG_OCR_ENABLED=false                              # Phase-3 无文字 PDF 页 OCR 回退开关（默认关，需配置视觉 key）
HOMMEY_RAG_OCR_CONFIDENCE_THRESHOLD=0.5                   # Phase-3 OCR 置信度门槛，低于则跳过该页并记录原因

# ── 车次查询配置（train-query，默认 12306 直连，免费无 Key）────
HOMMEY_TRAIN_QUERY_BACKEND=12306                          # 12306 | juhe（juhe 为付费/限频预留）
# juhe 聚合数据 AppKey（切换 juhe 后端时必填）。
HOMMEY_JUHE_TRAIN_KEY=
HOMMEY_TRAIN_QUERY_TIMEOUT_SEC=10.0                       # 单次 12306 请求超时（秒）
HOMMEY_TRAIN_QUERY_MAX_RETRIES=2                          # 站名表/瞬时失败最大重试次数
HOMMEY_TRAIN_QUERY_RETRY_BASE_DELAY_SEC=1.0               # 重试基础退避（指数增长）
HOMMEY_TRAIN_QUERY_RETRY_MAX_DELAY_SEC=10.0               # 重试最大退避上限
HOMMEY_TRAIN_STATION_CACHE_TTL_SEC=604800                 # 进程内 12306 站名表缓存 TTL（秒，默认 7 天）

# ── RAG HyDE 增强检索（用户选择后才调用，标准检索仍为默认）────────
HOMMEY_RAG_HYDE_ENABLED=True                              # 运维总开关；关闭后增强请求自动回退标准检索
HOMMEY_RAG_HYDE_TIMEOUT_SEC=12.0                          # 假想制度片段生成超时
HOMMEY_RAG_HYDE_MAX_CHARS=600                             # 生成文本最大字符数
HOMMEY_RAG_HYDE_CANDIDATE_TOP_K=10                       # HyDE dense-only 分支候选数
HOMMEY_RAG_HYDE_RRF_WEIGHT=0.6                           # HyDE 分支加权 RRF 权重
HOMMEY_RAG_HYDE_PROMPT_VERSION=hyde-policy-v1            # prompt/校验规则版本
HOMMEY_RAG_HYDE_TRACE_FILE=data/rag_knowledge/hyde_traces.jsonl

# ── 熔断、预算与重试（稳定性保障）──────────────────────────────
HOMMEY_MAX_RETRIES=3                            # 旧入口兼容用重试次数
HOMMEY_AGENT_MAX_RETRIES=1                      # 单个 Agent 最大重试次数
HOMMEY_RETRY_BASE_DELAY_SEC=1.0                 # 重试初始延迟（秒）
HOMMEY_RETRY_MAX_DELAY_SEC=30.0                 # 重试最大延迟（秒）
HOMMEY_MAX_AGENT_CALLS_PER_REQUEST=8            # 单请求 Agent 调用总上限（含重试）
HOMMEY_MAX_EXTERNAL_CALLS_PER_REQUEST=16        # 单请求 LLM/RAG/HTTP/MCP 调用总上限
HOMMEY_MAX_EXTERNAL_CALLS_PER_TYPE=6            # 单请求同类外部调用上限
HOMMEY_REQUEST_TIMEOUT_SEC=240                  # 单请求完整执行超时（秒，完整规划链路需要更长预算）
HOMMEY_CIRCUIT_FAILURE_THRESHOLD=5              # 熔断触发阈值（连续失败次数）
HOMMEY_CIRCUIT_RECOVERY_TIMEOUT_SEC=60.0        # 熔断恢复等待时间（秒）
HOMMEY_CIRCUIT_HALF_OPEN_SUCCESSES=2            # 半开状态成功次数阈值
HOMMEY_HEALTH_CHECK_TIMEOUT_SEC=10.0            # 健康检查超时（秒）

# ── 并发协调（Redis 锁/信号量，多 worker 一致性）─────────────────
HOMMEY_GLOBAL_CONCURRENCY_LIMIT=8               # 全局同时处理请求数上限（信号量槽位数）
HOMMEY_PER_USER_LOCK_TIMEOUT_SEC=60.0           # 同用户分布式锁排队超时（秒）
HOMMEY_SEMAPHORE_ACQUIRE_TIMEOUT_SEC=120.0      # 全局信号量获取超时（秒）
HOMMEY_DISTRIBUTED_LOCK_TTL_SEC=45.0            # 同用户分布式锁 TTL（心跳续约重设）
HOMMEY_SEMAPHORE_LEASE_TTL_SEC=45.0             # 全局信号量单租约 TTL（token 化租约，心跳续约）
HOMMEY_LOCK_HEARTBEAT_INTERVAL_SEC=12.0         # 锁/信号量心跳续约间隔（须 < TTL/3）
HOMMEY_LOCK_RETRY_INTERVAL_SEC=0.2              # 拿锁重试间隔（秒）
HOMMEY_IO_EXECUTOR_MAX_WORKERS=16               # 自有有界 I/O 线程池上限（RAG/embedding/psycopg）
HOMMEY_IO_EXECUTOR_MAX_PENDING=32                # I/O 线程池最大排队任务数，满载后快速失败

# ── 记忆系统 ────────────────────────────────────────────────────
# 短期记忆（memory 或 redis）
HOMMEY_SHORT_TERM_BACKEND=memory                # 后端类型: memory | redis
HOMMEY_SHORT_TERM_MAX_TURNS=10                  # 滑动窗口轮数
HOMMEY_SESSION_IDLE_TIMEOUT_SEC=600             # 10 分钟无操作后切分 session
HOMMEY_SESSION_REDIS_TTL_SEC=86400              # Redis 会话热数据保留 24 小时
HOMMEY_MEMORY_SAFETY_ENABLED=True               # 持久化、摘要和日志前脱敏

# Redis 配置（短期记忆，SHORT_TERM_BACKEND=redis 时生效）
HOMMEY_REDIS_HOST=127.0.0.1
HOMMEY_REDIS_PORT=6379
HOMMEY_REDIS_DB=0
# Redis 密码（可选；无密码时保持空值）
HOMMEY_REDIS_PASSWORD=
HOMMEY_REDIS_KEY_PREFIX=hommey:short_term

# 长期记忆（file 或 postgres）
HOMMEY_LONG_TERM_BACKEND=postgres               # 权威长期记忆统一使用 PostgreSQL
HOMMEY_MEMORY_STORAGE_PATH=data/memory          # JSON 文件存储路径（file 模式）

# PostgreSQL 配置（长期记忆，LONG_TERM_BACKEND=postgres 时生效）
# 示例：postgresql://hommey:password@localhost:5432/hommey
HOMMEY_POSTGRES_DSN=
HOMMEY_POSTGRES_POOL_MIN_SIZE=1                 # PostgreSQL 全局连接池最小连接数
HOMMEY_POSTGRES_POOL_MAX_SIZE=10                # PostgreSQL 全局连接池最大连接数
HOMMEY_POSTGRES_POOL_TIMEOUT_SEC=10             # 获取连接的最长等待时间（秒）
HOMMEY_RAW_MESSAGE_RETENTION_DAYS=14            # 脱敏原始聊天默认保留期

# 记忆系统渐进迁移开关（P0 默认仍使用兼容路径）
HOMMEY_MEMORY_V2_ENABLED=False
HOMMEY_MEMORY_V2_DUAL_WRITE=False
HOMMEY_MEMORY_V2_READ_MODE=legacy

# ── 聊天附件（多模态输入 P0）────────────────────────────────────
HOMMEY_UPLOADS_PATH=data/uploads                 # 附件原文件存储根目录（docker 需挂载卷）
HOMMEY_ATTACHMENT_MAX_BYTES=26214400             # 单文件上限（字节，默认 25 MB）
HOMMEY_ATTACHMENT_MAX_PER_MESSAGE=5              # 单条消息最多附件数
HOMMEY_ATTACHMENT_MAX_ARCHIVE_ENTRIES=2048       # DOCX 最大压缩条目数
HOMMEY_ATTACHMENT_MAX_ARCHIVE_BYTES=104857600    # DOCX 最大解压体积（默认 100 MB）
HOMMEY_ATTACHMENT_MAX_ARCHIVE_RATIO=100          # DOCX 最大压缩比
HOMMEY_ATTACHMENT_RETENTION_DAYS=30              # 附件保留期；过期后不能绑定新消息
HOMMEY_ATTACHMENT_ALLOWED_EXTENSIONS=txt,md,docx,pdf,png,jpg,jpeg,webp
HOMMEY_AGENT_QUERY_CHAR_BUDGET=12000             # 注入 agent_query 的附件文本总字符预算

# ── 图片识别（视觉模态；OpenAI 兼容接口，默认 SiliconFlow）────────
# 图片 → 多模态大模型一次性完成 OCR + 描述 + 结构化字段，产出文本进 agent 管道
HOMMEY_VISION_ENABLED=False                      # 开启图片上传/识别
# 视觉模型 API Key；也可用 SILICONFLOW_API_KEY。
HOMMEY_VISION_API_KEY=
HOMMEY_VISION_BASE_URL=https://api.siliconflow.cn/v1
HOMMEY_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
HOMMEY_VISION_TIMEOUT_SEC=30.0                   # 单次识别超时（秒）
HOMMEY_VISION_MAX_PIXELS=2458624                 # 下采样像素上限（默认 1568²）
HOMMEY_VISION_MAX_BYTES=10485760                 # 图片文件上限（字节，默认 10 MB）
HOMMEY_VISION_DAILY_LIMIT=50                     # 每用户每日识别次数上限

# ── 文档 OCR（Query PDF + RAG 扫描页；与图片理解模型解耦）───────────
HOMMEY_OCR_ENABLED=False                        # 开启后仅对 PDF 无文字页做 OCR
# 可留空，依次复用 SILICONFLOW_API_KEY / HOMMEY_VISION_API_KEY。
HOMMEY_OCR_API_KEY=
HOMMEY_OCR_BASE_URL=https://api.siliconflow.cn/v1
HOMMEY_OCR_MODEL=deepseek-ai/DeepSeek-OCR
HOMMEY_OCR_TIMEOUT_SEC=30.0
HOMMEY_OCR_MAX_RETRIES=2
HOMMEY_OCR_MAX_TOKENS=4096                         # 为图片输入预留模型上下文
HOMMEY_QUERY_PDF_OCR_MAX_PAGES=10                # 单份 Query PDF 最多 OCR 的无文字页数

# ── 语音转写（语音模态；Mode A：转写为文本后作为纯文本发送）──────
HOMMEY_ASR_ENABLED=False                         # 开启语音输入
# ASR API Key；也可用 SILICONFLOW_API_KEY。
HOMMEY_ASR_API_KEY=
HOMMEY_ASR_BASE_URL=https://api.siliconflow.cn/v1
HOMMEY_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
HOMMEY_ASR_TIMEOUT_SEC=60.0                      # 单次转写超时（秒）
HOMMEY_ASR_MAX_BYTES=26214400                    # 音频文件上限（字节，默认 25 MB）
HOMMEY_ASR_DAILY_LIMIT=100                       # 每用户每日转写次数上限

# 管理员邮箱（逗号分隔）；这些邮箱注册后可访问 Skill 管理平台
HOMMEY_ADMIN_EMAILS=admin@example.com

# JWT 签名密钥（必填，生产环境使用足够长的随机值）
HOMMEY_JWT_SECRET=replace-with-a-long-random-secret

# ── MCP 外部工具配置 ────────────────────────────────────────────
HOMMEY_MCP_AUTO_CONNECT=True                    # 是否自动连接 MCP Server
HOMMEY_MCP_CONNECT_TIMEOUT=10.0                 # 连接超时（秒）
HOMMEY_MCP_FILESYSTEM_ENABLED=False             # 是否启用文件系统 MCP Server
HOMMEY_MCP_FILESYSTEM_COMMAND=npx               # 启动命令

# ── Docker 专用（docker-compose 部署时使用）────────────────────
PG_PASSWORD=replace-with-a-strong-password      # PostgreSQL 密码
