{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval.turn.input.1",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "schema_version": {"const": "eval.turn.input.1"},
        "subject": {"type": "object"},
        "conversation": {"type": "object"},
        "routing": {"type": "object"},
        "execution": {"type": "object"},
        "answer": {"type": "object"},
        "evidence": {"type": "object"},
        "versions": {"type": "object"},
        "capture_mode": {"enum": ["live", "reconciled", "offline"]},
        "evaluation_context_quality": {"enum": ["full", "reduced"]},
        "metadata_truncated": {"type": "boolean"},
        "truncated_fields": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["schema_version", "subject", "conversation", "routing", "execution", "answer", "evidence", "versions"],
      "additionalProperties": false
    },
    "facts": {"type": "object"}
  },
  "required": ["metadata", "facts"],
  "additionalProperties": false
}
