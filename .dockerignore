# Python 虚拟环境
venv/
.venv/
env/
.env/

# Git
.git/
.gitignore
.gitattributes

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
.claude/
*.swp
*.swo

# 记忆数据（由 volume 管理）
data/memory/*.json

# 私有运行时数据与本地诊断产物，绝不能进入镜像层
data/backups/
data/uploads/
data/eval/
data/rag_scratch/

# RAG 向量数据（本地开发产物）
data/rag_knowledge/

# 模型文件（太大，通常挂载 volume 或用模型服务）
data/models/

# AgentScope 运行时
.agentscope/
# .agents/skills 是应用源码，必须被复制进运行镜像。

# 文档
docs/

# 测试
tests/
benchmark.py

# 环境配置（敏感信息通过 docker-compose env_file 注入；示例文件也不需要进镜像）
.env*

# 系统文件
Thumbs.db
*.log
